# Jarvis config — this machine (5090 brain PC; the client section is used when
# the client runs here for testing, and ships as-is to the living-room PC).

server:
  host: 0.0.0.0
  port: 8765

  stt:
    model: large-v3
    device: cuda
    compute_type: float16
    language: null                    # auto-detect within allowed_languages
    allowed_languages: [en, ru, es]   # the only languages spoken in the room

  llm:
    provider: ollama_native
    base_url: http://127.0.0.1:11434/v1
    model: millard-qwen4:latest        # Qwen3.6-35B-A3B, multimodal - smarter and handles vision itself
    api_key: ollama
    think: false
    vision_model: qwen2.5vl:7b        # fast NON-thinking vision (~2 s); qwen3-vl thinks and returned empty
                                       # Coexists with millard (22+6 GB); OLLAMA_MAX_LOADED_MODELS=3 keeps both, no swaps.
    temperature: 0.3         # lower = more disciplined tool use; it claimed unperformed actions at 0.6
    max_tokens: 1024
    max_tool_rounds: 6       # computer-use chains (open site -> click -> type -> click) need headroom
    history_turns: 12
    keep_alive: 4h           # keep the chat model in VRAM between requests
    num_ctx: 8192            # smaller context = several GB of VRAM saved vs the 32k default

  speaker:
    enabled: true
    threshold: 0.62          # cosine for a voice match; 0.72 dropped Anton's own voice on quieter utterances
    admin_threshold: 0.70    # run_command / set_role need this much confidence (a lookalike voice can't run commands)
    min_speech_s: 0.8        # shorter utterances are left unidentified

  face:                      # face recognition + presence (v1.4, insightface on this PC)
    enabled: true
    threshold: 0.45          # cosine similarity for a face to match a profile
    presence_ttl_s: 30       # forget someone this long after last seeing them
    greet_after_s: 10        # greet an unknown face after this many seconds
    greeting_cooldown_s: 60   # one greeting per minute (300 s made testing impossible)
    burst_size: 3             # frames per multi-frame camera pull (v1.4 burst)
    enroll_bursts: 3          # background bursts enroll_face pulls after its first sample

  segment:                   # SAM3 open-vocabulary object finder (v1.5, find_object tool)
    enabled: true
    checkpoint: third_party/sam3/server/model/sam3.pt   # resolved relative to the repo root
    confidence: 0.5           # SAM3 match threshold (owner's pick)

  tts:
    engine: silero
    language: en
    model_id: v3_en
    speaker: en_0
    sample_rate: 48000

client:
  server_url: wss://dorm-smart-un-iversity-of-nebr-omaha.ngrok.app/ws
  client_id: livingroom

  wakeword:
    word: rowan
    phrases: [rowan, roan, rowen]
    vosk_model: models/vosk-model-small-en-us-0.15

  audio:
    input_device: null
    output_device: null
    sample_rate: 16000

  vad:
    aggressiveness: 3        # strict speech detection - a noisy webcam mic stretches the tail otherwise
    silence_ms: 700
    max_utterance_s: 15
    pre_roll_ms: 300
    min_speech_ms: 250       # shorter voiced bursts are noise blips - dropped, listening continues

  followup_window_s: 6
  thinking_sounds: true    # soft blips while Jarvis is still working on a reply

  camera:                  # C920 room camera -> YOLO presence + face frames (v1.4)
    enabled: true
    index: 0               # OpenCV device index
    fps: 3                 # yolo11x pre/post-processing is GIL-heavy: at 8 fps it starved
                           # the microphone loop ("queue is full") and the wake word went deaf
    model: yolo11x.pt      # the biggest one - owner's pick; quality first
    face_check_interval_s: 5   # push one frame this often while someone is visible

  overlay:                 # sci-fi HUD on the TV (Tkinter, transparent, click-through)
    enabled: true
    position: bottom_right # orb corner
    idle_hidden: false     # hide the orb entirely when idle
    scale: 1.0

  apps: {}

  devices: []










