  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Turn latency by stage (p95, ms)",
      "description": "ТЗ 15.1: бюджеты стадий — STT 700 мс, диаризация 700 мс, узнавание голоса 700 мс.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "diarization" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(rowan_turn_stage_milliseconds_bucket[$__rate_interval])) by (le, stage))",
          "legendFormat": "{{stage}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(rowan_turn_stage_milliseconds_bucket[$__rate_interval])) by (le, stage))",
          "legendFormat": "{{stage}} p50",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Turn latency by home (p95, ms)",
      "description": "ТЗ 15.1: реплика одной комнаты не задерживает другую дольше 1,5 с.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(rowan_turn_stage_milliseconds_bucket{stage=\"total\"}[$__rate_interval])) by (le, home))",
          "legendFormat": "{{home}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU queue",
      "description": "Длина очереди видеокарты и отказы: хвост растёт раньше, чем комнаты это почувствуют.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rowan_gpu_queue_jobs",
          "legendFormat": "{{state}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rowan_gpu_queue_wait_seconds",
          "legendFormat": "wait {{class}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_gpu_queue_dropped_total[$__rate_interval])",
          "legendFormat": "dropped",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Video memory",
      "description": "Память видеокарты в байтах, как её отдаёт драйвер CUDA.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rowan_gpu_vram_bytes",
          "legendFormat": "{{kind}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Turns, incomplete turns and errors",
      "description": "ТЗ F-704: деградации хода видно отдельно от удач, иначе отчёт смотрит только на успехи.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_turns_total[$__rate_interval])",
          "legendFormat": "turns {{home}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_turn_degraded_total[$__rate_interval])",
          "legendFormat": "degraded {{stage}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_turn_errors_total[$__rate_interval])",
          "legendFormat": "errors {{kind}}",
          "range": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_outbound_dropped_total[$__rate_interval])",
          "legendFormat": "dropped frames {{kind}}",
          "range": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_scheduler_failures_total[$__rate_interval])",
          "legendFormat": "job failures {{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cloud API budget (USD, this month)",
      "description": "Собственный консервативный учёт хаба: резервации считаются расходом, пока не подтверждены.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rowan_api_budget_usd",
          "legendFormat": "{{kind}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rowan_api_unsettled_requests",
          "legendFormat": "unsettled requests",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Which model level answered",
      "description": "ТЗ F-401: видно, сколько ходов ушло в облако, а сколько осталось локальным.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(rowan_turn_level_total[$__rate_interval])",
          "legendFormat": "{{level}}",
          "range": true
        }
      ]
    }
  ],
